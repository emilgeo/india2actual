{
  "name": "india2actual",
  "version": "0.4.0",
  "description": "Convert Indian bank statements (CSV, XLS, PDF) into Actual Budget transactions with real merchant names",
  "license": "MIT",
  "author": "emilgeo",
  "homepage": "https://india2actual.emil.ge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emilgeo/india2actual.git"
  },
  "bugs": {
    "url": "https://github.com/emilgeo/india2actual/issues"
  },
  "keywords": [
    "actual",
    "actual-budget",
    "budgeting",
    "personal-finance",
    "india",
    "indian-banks",
    "upi",
    "bank-statement",
    "csv",
    "pdf",
    "importer",
    "converter"
  ],
  "bin": {
    "india2actual": "dist/cli.js"
  },
  "type": "module",
  "files": [
    "dist",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:web": "node scripts/build-web.mjs",
    "test:web": "playwright test"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.5.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "node-html-parser": "^9.0.4",
    "pdfjs-dist": "^6.3.289"
  },
  "optionalDependencies": {
    "@actual-app/api": "^26.10.0"
  },
  "devDependencies": {
    "@actual-app/sync-server": "^26.10.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "preact": "^11.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.14"
  }
}
